# --- Backend ---
# Provide these to the backend process (the server does NOT auto-load .env).
PORT=3001
# SQLite database file location (default: packages/qa-lens.db)
DB_PATH=./packages/qa-lens.db
# Internal clone storage for GitHub-managed repositories
MANAGED_REPOS_PATH=./packages/managed-repos
# Allowed CORS origin for the backend
CLIENT_ORIGIN=http://localhost:5173

# --- AI providers ---
# Provider order for the waterfall (claude -> gemini -> cursor -> anthropic)
AI_PROVIDERS=claude,gemini,cursor,anthropic
# Required only when the `anthropic` provider is used
ANTHROPIC_API_KEY=
# Optional extra CLI model choices shown in Settings (comma-separated)
AI_MODELS_CLAUDE=
AI_MODELS_GEMINI=
AI_MODELS_CURSOR=
# Set to 1 to dump each AI call's prompt/response/meta to packages/backend/.ai-debug/
AI_DEBUG_DUMP=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
